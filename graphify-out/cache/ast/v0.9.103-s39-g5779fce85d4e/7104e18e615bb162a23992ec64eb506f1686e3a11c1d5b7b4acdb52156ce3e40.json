{"nodes": [{"id": "$graphify-root$_agent_skills_trader_exit_skill_md", "label": "SKILL.md", "file_type": "document", "node_kind": "page", "source_file": ".agent/skills/trader-exit/SKILL.md", "source_location": "L1", "frontmatter": {"name": "trader-exit", "description": "Exit Planner. Sets your stop and your target before you enter, so you know when to get out. Reads the entry from trader-entry (or a price you give), puts the stop at the opening-range midpoint by default (or the range low, your price, a percent, or a multiple of the ATR), rounds it down to the cent, and sets the target at 2R (or 1R, or your price). Refuses a stop at or above the entry, a target at or below it, or a stop too tight to survive the spread, and says why. Writes trader/plan.json for the Time Mach", "argument-hint": "[--stop or-mid|or-low|price:X|pct:X|atr:K] [--target 2R|1R|price:X]"}}, {"id": "$graphify-root$_agent_skills_trader_exit_skill_trader_exit", "label": "trader-exit", "file_type": "document", "node_kind": "heading", "source_file": ".agent/skills/trader-exit/SKILL.md", "source_location": "L18"}, {"id": "$graphify-root$_agent_skills_trader_exit_skill_what_it_reads_and_writes", "label": "What it reads and writes", "file_type": "document", "node_kind": "heading", "source_file": ".agent/skills/trader-exit/SKILL.md", "source_location": "L41"}, {"id": "$graphify-root$_agent_skills_trader_exit_skill_stops_and_targets", "label": "Stops and targets", "file_type": "document", "node_kind": "heading", "source_file": ".agent/skills/trader-exit/SKILL.md", "source_location": "L50"}, {"id": "$graphify-root$_agent_skills_trader_exit_skill_steps", "label": "Steps", "file_type": "document", "node_kind": "heading", "source_file": ".agent/skills/trader-exit/SKILL.md", "source_location": "L73"}, {"id": "$graphify-root$_agent_skills_trader_exit_skill_example_the_reel", "label": "Example: the reel", "file_type": "document", "node_kind": "heading", "source_file": ".agent/skills/trader-exit/SKILL.md", "sou