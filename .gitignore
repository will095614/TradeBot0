# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/

# Virtual Environments
.venv/
.freebuff/
env/
venv/
ENV/

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/

# Local memory / run histories (created dynamically at runtime)
memory/

# IDE & Editor caches
.idea/
.vscode/
*.swp
*.swo

# OS generated files
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# TradeBot0 runtime logs & local databases (audit 3.10 / V2.0.0 hygiene)
data/logs/
logs/
installer-output/
data/*.db
data/*.db-*
graphify-out/
.graphifyignore
*.lnk

# Runtime system config (audit 3.18): per-machine state, never versioned
data/system_config.json

# Local secrets (never versioned; API key lives in data/system_config.json, never in the repo)
.env
.env.*
