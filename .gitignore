# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/

# Virtual Environments
.venv/
.freebuff/
env/
venv/
ENV/

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/

# Local memory / run histories (preserve directory structure)
memory/*.json
memory/*.json.bak
memory/*.md
memory/*.md.bak
!memory/.gitkeep

# IDE & Editor caches
.idea/
.vscode/
*.swp
*.swo

# OS generated files
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# TradeBot0 runtime logs (audit 3.10)
data/logs/

# Runtime system config (audit 3.18): per-machine state, never versioned
data/system_config.json
