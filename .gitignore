# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/

# Virtual Environments
.venv/
.freebuff/
env/
venv/
ENV/

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/

# Local memory / run histories (preserve directory structure)
memory/*.json
memory/*.json.bak
memory/*.md
memory/*.md.bak
!memory/.gitkeep

# IDE & Editor caches
.idea/
.vscode/
*.swp
*.swo

# OS generated files
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# TradeBot0 runtime logs & local databases (audit 3.10 / V2.0.0 hygiene)
data/logs/
logs/
installer-output/
data/*.db
data/*.db-*
graphify-out/cache/
graphify-out/.graphify_python
graphify-out/.graphify_partition_cache.json
graphify-out/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/

# Runtime system config (audit 3.18): per-machine state, never versioned
data/system_config.json

# Local secrets (never versioned; keys live in ~/.omniroute/.env, never in the repo)
.env
.env.*
